# Copy to .env (gitignored). Required for `domo dev`, `domo publish`, and any
# script that hits the Domo Product API directly via curl.
#
# Variable naming is canonical: DOMO_DEVELOPER_TOKEN, not DOMO_TOKEN or
# DEV_TOKEN. The workspace ~/work/.env may use DOMO_TOKEN for ad-hoc shell work;
# per-project .env aligns with the scaffolds.

# Customer Domo instance (e.g. customer-demo.domo.com — the subdomain only).
DOMO_INSTANCE=

# Developer token from <instance>/admin/security/accesstokens.
# Treat like a password. Never commit.
DOMO_DEVELOPER_TOKEN=

# OAuth client credentials from developer.domo.com (only if using the Platform
# OAuth API, e.g. Datasets / Streams CRUD; not needed for in-app work).
DOMO_CLIENT_ID=
DOMO_CLIENT_SECRET=
